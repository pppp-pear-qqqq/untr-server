events {
	worker_connections 1024;
}

http {
	# ContentType設定
	include mime.types;
	default_type text/plain;
	charset utf-8;
	charset_types text/plain text/css application/json application/javascript;

	# gzip圧縮設定
	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 6;
	gzip_min_length 256;
	gzip_buffers 16 8k;
	gzip_http_version 1.1;
	gzip_types text/plain text/css text/javascript application/xml application/json application/javascript image/svg+xml;

	open_file_cache max=1000 inactive=20s;
	open_file_cache_valid 30s;
	open_file_cache_min_uses 2;
	open_file_cache_errors on;

	map $host $app_name {
		localhost				portal;
		# dpdpdp.localhost		dpdpdp;
		# strings.localhost		strings;
		# charadie.localhost	charadie;
		# colllus.localhost		colllus;
		# erltod.localhost		erltod;
		ondyst.localhost		ondyst;
	}
	map $host $app_port {
		localhost				8000;
		# dpdpdp.localhost		8001;
		# strings.localhost		8002;
		# charadie.localhost	8003;
		# colllus.localhost		8004;
		# erltod.localhost		8005;
		ondyst.localhost		8006;
	}

	server {
		listen 8080 default_server;
		server_name _;
		return 404;
	}

	server {
		listen 8080;
		server_name
			# dpdpdp.localhost
			# strings.localhost
			# charadie.localhost
			# colllus.localhost
			# erltod.localhost
			ondyst.localhost
			localhost;

		root /app/app/$app_name;

		resolver 127.0.0.11 valid=30s; # 開発用

		location /common/ {
			alias /app/app/common/;
			access_log off;
			log_not_found off;
		}
		location /.well-known/ {
			alias /app/app/common/resource/.well-known/;
			access_log off;
			log_not_found off;
		}

		location /image/ {
			try_files $uri =404;
			access_log off;
			log_not_found off;
		}
		location ~ ^/(script|style)/(.+)$ {
			try_files /$1${ASSET_SUFFIX}/$2 =404;
			access_log off;
			log_not_found off;
		}
		location = /favicon.ico {
			try_files /image/favicon.ico =404;
			access_log off;
			log_not_found off;
		}

		location / {
			set $upstream http://$app_name:$app_port; # 開発用
			# set $upstream http://127.0.0.1:$app_port; # 本番用

			proxy_pass $upstream;
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}
	}
}
