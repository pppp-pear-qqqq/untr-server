events {
	worker_connections 1024;
}

http {
	# ContentType設定
	include mime.types;
	default_type text/plain;
	charset utf-8;
	charset_types text/plain text/css application/json application/javascript;

	# gzip圧縮設定
	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 6;
	gzip_min_length 256;
	gzip_buffers 16 8k;
	gzip_http_version 1.1;
	gzip_types text/plain text/css text/javascript application/xml application/json application/javascript image/svg+xml;

	open_file_cache max=1000 inactive=20s;
	open_file_cache_valid 30s;
	open_file_cache_min_uses 2;
	open_file_cache_errors on;

	map $host $app_name {
		localhost				portal;
		untroche.com			portal;
		# dpdpdp\.(localhost|untroche\.com)$	dpdpdp;
		# strings\.(localhost|untroche\.com)$	strings;
		# charadie\.(localhost|untroche\.com)$	charadie;
		# colllus\.(localhost|untroche\.com)$	colllus;
		# erltod\.(localhost|untroche\.com)$	erltod;
		~^ondyst\.(localhost|untroche\.com)$	ondyst;
	}
	map $host $app_port {
		localhost				8000;
		untroche.com			8000;
		# ~^dpdpdp\.(localhost|untroche\.com)$	8001;
		# ~^strings\.(localhost|untroche\.com)$	8002;
		# ~^charadie\.(localhost|untroche\.com)$	8003;
		# ~^colllus\.(localhost|untroche\.com)$	8004;
		# ~^erltod\.(localhost|untroche\.com)$	8005;
		~^ondyst\.(localhost|untroche\.com)$	8006;
	}

	# 未定義ホストヘッダーへのアクセスを弾く
	server {
		listen 80 default_server;
		listen 443 ssl default_server;
		server_name _;

		ssl_certificate /app/ssl/fullchain.pem;
		ssl_certificate_key /app/ssl/privkey.pem;

		return 404;
	}

	# HTTPリダイレクト
	server {
		listen 80;
		server_name untroche.com *.untroche.com localhost *.localhost;

		return 301 https://$host$request_uri;
	}

	# メイン
	server {
		listen 443 ssl;
		server_name
			untroche.com
			*.untroche.com
			localhost
			*.localhost;

		# 証明書設定
		ssl_certificate /app/ssl/fullchain.pem;
		ssl_certificate_key /app/ssl/privkey.pem;
		# プロトコルと暗号設定
		ssl_protocols TLSv1.2 TLSv1.3;
		ssl_ciphers HIGH:!aNULL:!MD5;

		root /app/app/$app_name;

		resolver 127.0.0.11 valid=30s; # 開発用

		location ~ ^/common/(script|style)/(.+)$ {
			alias /app/app/common/$1${ASSET_SUFFIX}/$2;
			access_log off;
			log_not_found off;
		}
		location /common/ {
			alias /app/app/common/;
			access_log off;
			log_not_found off;
		}
		location /.well-known/ {
			alias /app/app/common/.well-known/;
			access_log off;
			log_not_found off;
		}

		location /image/ {
			access_log off;
			log_not_found off;
		}
		location ~ ^/(script|style)/(.+)$ {
			try_files /$1${ASSET_SUFFIX}/$2 /common/$1${ASSET_SUFFIX}/$2;
			access_log off;
			log_not_found off;
		}
		location = /favicon.ico {
			try_files /image/favicon.ico =404;
			access_log off;
			log_not_found off;
		}

		location / {
			set $upstream http://$app_name:$app_port; # 開発用
			# set $upstream http://127.0.0.1:$app_port; # 本番用

			proxy_pass $upstream;
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}
	}
}
